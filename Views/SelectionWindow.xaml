                            PreviewMouseWheel="Thickness_MouseWheel" />
                    <TextBlock x:Name="ThicknessPopupValue" Grid.Column="2" Text="4" Foreground="{DynamicResource TextBrush}"
                               FontSize="13" TextAlignment="Right" VerticalAlignment="Center" />
