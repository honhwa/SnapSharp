                  <Border Width="158" Background="{DynamicResource ToolbarBackgroundBrush}" BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="1"
                          CornerRadius="9" Padding="4">
                    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.58" Color="#000000" /></Border.Effect>
                    <StackPanel x:Name="StrokeStyleMenu">
                      <Button Style="{StaticResource LineStyleOptionButton}" Tag="Solid" Click="StrokeStyleButton_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Solid}"><Line X1="0" X2="112" Y1="0" Y2="0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" /></Button>
                      <Button Style="{StaticResource LineStyleOptionButton}" Tag="Dash" Click="StrokeStyleButton_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Dashed}"><Line X1="0" X2="112" Y1="0" Y2="0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeDashArray="4,2" /></Button>
                      <Button Style="{StaticResource LineStyleOptionButton}" Tag="Dot" Click="StrokeStyleButton_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Dotted}"><Line X1="0" X2="112" Y1="0" Y2="0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeDashArray="1,2" StrokeDashCap="Round" /></Button>
                      <Button Style="{StaticResource LineStyleOptionButton}" Tag="LongDash" Click="StrokeStyleButton_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:LongDash}"><Line X1="0" X2="112" Y1="0" Y2="0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeDashArray="8,2" /></Button>
                      <Button Style="{StaticResource LineStyleOptionButton}" Tag="DashDot" Click="StrokeStyleButton_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:DashDot}"><Line X1="0" X2="112" Y1="0" Y2="0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeDashArray="5,2,1,2" /></Button>
                      <Button Style="{StaticResource LineStyleOptionButton}" Tag="DashDotDot" Click="StrokeStyleButton_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:DashDotDot}"><Line X1="0" X2="112" Y1="0" Y2="0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeDashArray="5,2,1,2,1,2" /></Button>
                    </StackPanel>
                  </Border>
                </Popup>
              </Grid>
            </Border>
            <Grid Margin="8,0,0,0">
              <ToggleButton Style="{StaticResource ToolbarFieldToggle}" x:Name="ThicknessDropDownToggle" Width="78" Height="32" Background="{DynamicResource ControlBrush}"
                            BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="1" Cursor="Hand" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:AdjustThickness}"
                            PreviewMouseWheel="Thickness_MouseWheel">
                <Grid Margin="8,0,7,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <iconPacks:PackIconLucide Kind="SlidersHorizontal" Foreground="{DynamicResource TextBrush}" />
                  <TextBlock x:Name="ThicknessText" Grid.Column="1" Text="4" Foreground="{DynamicResource TextBrush}"
                             FontSize="13" TextAlignment="Center" VerticalAlignment="Center" />
                </Grid>
              </ToggleButton>
