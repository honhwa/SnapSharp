                  </Grid>
                </Border>
              </Popup>
            </Grid>
            <Separator Style="{StaticResource SecondarySeparator}" />
          </WrapPanel>

          <WrapPanel x:Name="ColorOptions" Orientation="Horizontal" VerticalAlignment="Center">
