                  </Grid>
                </Border>
              </Popup>
            </Grid>
            <Separator Style="{StaticResource SecondarySeparator}" />
          </WrapPanel>

          <WrapPanel x:Name="ArrowOptions" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Arrow}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,5,0" />
            <Border Width="96" Height="32" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource ToolbarBorderBrush}"
                    BorderThickness="1" CornerRadius="6">
              <Grid>
                <ToggleButton Style="{StaticResource ToolbarFieldToggle}" x:Name="ArrowStyleDropDownToggle" Width="94" Height="30" Background="Transparent"
                              BorderThickness="0" Cursor="Hand" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:ChooseArrowStyle}">
                  <Grid Margin="10,0,7,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
                    <local:ArrowStylePreview x:Name="SelectedArrowPreview" Width="48" Height="20" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                    <iconPacks:PackIconLucide Grid.Column="1" Kind="ChevronDown" Width="15" Height="15"
                                                Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                </ToggleButton>
                <Popup x:Name="ArrowStylePopup" PlacementTarget="{Binding ElementName=ArrowStyleDropDownToggle}"
                       Placement="Bottom" VerticalOffset="5" AllowsTransparency="True" PopupAnimation="Fade"
                       StaysOpen="False" IsOpen="{Binding IsChecked, ElementName=ArrowStyleDropDownToggle, Mode=TwoWay}">
                  <Border Width="116" Background="{DynamicResource ToolbarBackgroundBrush}" BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="1"
                          CornerRadius="9" Padding="4">
                    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.58" Color="#000000" /></Border.Effect>
                    <StackPanel x:Name="ArrowStyleMenu">
                      <Button Style="{StaticResource LineStyleOptionButton}" Tag="TaperedOutline" Click="ArrowStyleButton_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:TaperedOutlineArrow}"><local:ArrowStylePreview ArrowStyle="TaperedOutline" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
                      <Button Style="{StaticResource LineStyleOptionButton}" Tag="TaperedFilled" Click="ArrowStyleButton_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:TaperedFilledArrow}"><local:ArrowStylePreview ArrowStyle="TaperedFilled" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
                      <Button Style="{StaticResource LineStyleOptionButton}" Tag="EndOpen" Click="ArrowStyleButton_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:SingleArrow}"><local:ArrowStylePreview ArrowStyle="EndOpen" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
                      <Button Style="{StaticResource LineStyleOptionButton}" Tag="BothOpen" Click="ArrowStyleButton_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:DoubleArrow}"><local:ArrowStylePreview ArrowStyle="BothOpen" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
                      <Button Style="{StaticResource LineStyleOptionButton}" Tag="StartOpen" Click="ArrowStyleButton_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:ReverseArrow}"><local:ArrowStylePreview ArrowStyle="StartOpen" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
                      <Button Style="{StaticResource LineStyleOptionButton}" Tag="EndFilled" Click="ArrowStyleButton_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:FilledArrow}"><local:ArrowStylePreview ArrowStyle="EndFilled" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
                      <Button Style="{StaticResource LineStyleOptionButton}" Tag="BothFilled" Click="ArrowStyleButton_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:DoubleFilledArrow}"><local:ArrowStylePreview ArrowStyle="BothFilled" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
                      <Button Style="{StaticResource LineStyleOptionButton}" Tag="EndOpenStartBar" Click="ArrowStyleButton_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:ArrowWithStartBar}"><local:ArrowStylePreview ArrowStyle="EndOpenStartBar" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
                      <Button Style="{StaticResource LineStyleOptionButton}" Tag="StartOpenEndBar" Click="ArrowStyleButton_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:ArrowWithEndBar}"><local:ArrowStylePreview ArrowStyle="StartOpenEndBar" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
                      <Button Style="{StaticResource LineStyleOptionButton}" Tag="Bars" Click="ArrowStyleButton_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:BarsAtBothEnds}"><local:ArrowStylePreview ArrowStyle="Bars" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
                    </StackPanel>
                  </Border>
                </Popup>
              </Grid>
            </Border>
            <Separator Style="{StaticResource SecondarySeparator}" />
          </WrapPanel>

          <WrapPanel x:Name="StrokeOptions" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="StrokeLabel" Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:LineStyle}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,5,0" />
            <Border x:Name="StrokeStyleGroup" Width="122" Height="32" Background="{DynamicResource ControlBrush}"
                    BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="1" CornerRadius="6">
              <Grid>
                <ToggleButton Style="{StaticResource ToolbarFieldToggle}" x:Name="StrokeStyleDropDownToggle" Width="120" Height="30" Background="Transparent"
                              BorderThickness="0" Cursor="Hand" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:ChooseLineStyle}">
                  <Grid Margin="13,0,9,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="20" /></Grid.ColumnDefinitions>
                    <Line x:Name="SelectedStrokePreview" X1="0" X2="76" Y1="0" Y2="0" Stroke="{DynamicResource TextBrush}"
                          StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <iconPacks:PackIconLucide Grid.Column="1" Kind="ChevronDown" Width="16" Height="16"
                                                Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                RenderTransformOrigin="0.5,0.5">
                      <iconPacks:PackIconLucide.Style>
                        <Style TargetType="iconPacks:PackIconLucide" BasedOn="{StaticResource ToolbarIcon}">
                          <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="0" /></Setter.Value></Setter>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=StrokeStyleDropDownToggle}" Value="True">
                              <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" /></Setter.Value></Setter>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </iconPacks:PackIconLucide.Style>
                    </iconPacks:PackIconLucide>
                  </Grid>
                </ToggleButton>
                <Popup x:Name="StrokeStylePopup" PlacementTarget="{Binding ElementName=StrokeStyleDropDownToggle}"
                       Placement="Bottom" VerticalOffset="5" AllowsTransparency="True" PopupAnimation="Fade"
