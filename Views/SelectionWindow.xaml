                <Border Width="260" Height="330" Background="{DynamicResource ToolbarBackgroundBrush}" BorderBrush="{DynamicResource ToolbarBorderBrush}"
                        BorderThickness="1" CornerRadius="9" Padding="8">
                  <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.58" Color="#000000" /></Border.Effect>
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBox x:Name="FontSearchBox" Height="32" Padding="8,3" Background="{DynamicResource ControlBrush}"
                             Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="1"
                             TextChanged="FontSearchBox_TextChanged" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:SearchFonts}" />
                    <ListBox x:Name="FontFamilyList" Grid.Row="1" Margin="0,5,0,0"
                             Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="FontFamilyList_SelectionChanged">
                      <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                          <Setter Property="Padding" Value="10,6" />
                          <Setter Property="Margin" Value="0,1" />
                          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="FontItemSurface" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                              <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FontItemSurface" Property="Background" Value="#34373D" /></Trigger>
                              <Trigger Property="IsSelected" Value="True"><Setter TargetName="FontItemSurface" Property="Background" Value="#286BD6" /></Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate></Setter.Value></Setter>
                        </Style>
                      </ListBox.ItemContainerStyle>
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Source}" FontFamily="{Binding}" FontSize="17"
                                     Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>
              </Popup>
            </Grid>
            <Grid>
              <ToggleButton Style="{StaticResource ToolbarFieldToggle}" x:Name="FontSizeDropDownToggle" Width="78" Height="32" Background="{DynamicResource ControlBrush}"
                            BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="1" Cursor="Hand" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:AdjustFontSize}"
                            PreviewMouseWheel="FontSize_MouseWheel">
                <Grid Margin="8,0,7,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Text="Aa" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <TextBlock x:Name="FontSizeText" Grid.Column="1" Text="96" Foreground="{DynamicResource TextBrush}"
                             FontSize="13" TextAlignment="Center" VerticalAlignment="Center" />
                </Grid>
              </ToggleButton>
              <Popup x:Name="FontSizePopup" PlacementTarget="{Binding ElementName=FontSizeDropDownToggle}"
                     Placement="Bottom" HorizontalOffset="-92" VerticalOffset="6" AllowsTransparency="True"
                     PopupAnimation="Fade" StaysOpen="False"
                     IsOpen="{Binding IsChecked, ElementName=FontSizeDropDownToggle, Mode=TwoWay}">
                <Border Width="282" Background="{DynamicResource ToolbarBackgroundBrush}" BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="16" PreviewMouseWheel="FontSize_MouseWheel">
                  <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.58" Color="#000000" /></Border.Effect>
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:FontSize}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Slider x:Name="FontSizeSlider" Grid.Column="1" Style="{StaticResource ThicknessSliderStyle}"
                            Width="142" Minimum="10" Maximum="96" Value="96" TickFrequency="2"
                            IsSnapToTickEnabled="True" ValueChanged="FontSize_Changed"
                            PreviewMouseWheel="FontSize_MouseWheel" />
                    <TextBlock x:Name="FontSizePopupValue" Grid.Column="2" Text="96" Foreground="{DynamicResource TextBrush}"
                               FontSize="13" TextAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:DragSliderOrUseMouseWheelTo}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,7,0,0" />
                  </Grid>
                </Border>
              </Popup>
            </Grid>
            <Grid x:Name="TextOutlineControl" Margin="6,0,0,0">
              <ToggleButton Style="{StaticResource ToolbarFieldToggle}" x:Name="TextOutlineDropDownToggle" Width="32" Height="32" Background="{DynamicResource ControlBrush}"
                            BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="1" Cursor="Hand" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:TextOutline}"
                            PreviewMouseWheel="TextOutline_MouseWheel">
                <TextBlock Text="T" Foreground="{DynamicResource TextBrush}" FontSize="18" FontWeight="SemiBold" />
              </ToggleButton>
              <Popup x:Name="TextOutlinePopup" PlacementTarget="{Binding ElementName=TextOutlineDropDownToggle}"
                     Placement="Bottom" HorizontalOffset="-126" VerticalOffset="6" AllowsTransparency="True"
                     PopupAnimation="Fade" StaysOpen="False"
                     IsOpen="{Binding IsChecked, ElementName=TextOutlineDropDownToggle, Mode=TwoWay}">
                <Border Width="320" Background="{DynamicResource ToolbarBackgroundBrush}" BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="16" PreviewMouseWheel="TextOutline_MouseWheel">
                  <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.58" Color="#000000" /></Border.Effect>
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions>
                    <CheckBox x:Name="OutlineEnabledToggle" Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Outline}" Foreground="{DynamicResource TextBrush}"
                              VerticalAlignment="Center" Click="OutlineEnabled_Changed" />
                    <Slider x:Name="TextOutlineSlider" Grid.Column="1" Style="{StaticResource ThicknessSliderStyle}"
                            Width="146" Minimum="0.5" Maximum="12" Value="8" TickFrequency="0.5"
                            IsSnapToTickEnabled="True" ValueChanged="TextOutline_Changed"
                            PreviewMouseWheel="TextOutline_MouseWheel" />
                    <TextBlock x:Name="TextOutlineValue" Grid.Column="2" Text="8" Foreground="{DynamicResource TextBrush}"
                               FontSize="13" TextAlignment="Right" VerticalAlignment="Center" />
                    <StackPanel x:Name="OutlineColorOptions" Grid.Row="1" Grid.ColumnSpan="3"
                                Orientation="Horizontal" Margin="0,9,0,0">
                      <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Color}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Width="42" VerticalAlignment="Center" />
                      <Button Style="{StaticResource ColorSwatchButton}" Tag="#FFFFFF" Click="OutlineColor_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:White}" Background="#FFFFFF" BorderBrush="#77777C" />
                      <Button Style="{StaticResource ColorSwatchButton}" Tag="#E84A3C" Click="OutlineColor_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Red}" Background="#E84A3C" />
                      <Button Style="{StaticResource ColorSwatchButton}" Tag="#FFD60A" Click="OutlineColor_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Yellow}" Background="#FFD60A" />
                      <Button Style="{StaticResource ColorSwatchButton}" Tag="#30D158" Click="OutlineColor_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Green}" Background="#30D158" />
                      <Button Style="{StaticResource ColorSwatchButton}" Tag="#0A84FF" Click="OutlineColor_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Blue}" Background="#0A84FF" />
                      <Button Style="{StaticResource ColorSwatchButton}" Tag="#111111" Click="OutlineColor_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Black}" Background="#111111" BorderBrush="#77777C" />
                      <Button Style="{StaticResource SecondaryButton}" Click="OutlineCustomColor_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:CustomOutlineColor}"><iconPacks:PackIconLucide Kind="Palette" /></Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </Popup>
            </Grid>
          </WrapPanel>

          <WrapPanel x:Name="EffectOptions" Orientation="Horizontal" VerticalAlignment="Center">
            <Grid>
              <ToggleButton Style="{StaticResource ToolbarFieldToggle}" x:Name="EffectDropDownToggle" Width="92" Height="32" Background="{DynamicResource ControlBrush}"
                            BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="1" Cursor="Hand" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:AdjustEffect}"
                            PreviewMouseWheel="Effect_MouseWheel">
                <Grid Margin="8,0,7,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock x:Name="EffectCompactLabel" Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Intensity}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <TextBlock x:Name="EffectText" Grid.Column="1" Text="8" Foreground="{DynamicResource TextBrush}"
                             FontSize="13" TextAlignment="Center" VerticalAlignment="Center" />
                </Grid>
              </ToggleButton>
              <Popup x:Name="EffectPopup" PlacementTarget="{Binding ElementName=EffectDropDownToggle}"
                     Placement="Bottom" HorizontalOffset="-85" VerticalOffset="6" AllowsTransparency="True"
                     PopupAnimation="Fade" StaysOpen="False"
                     IsOpen="{Binding IsChecked, ElementName=EffectDropDownToggle, Mode=TwoWay}">
                <Border Width="282" Background="{DynamicResource ToolbarBackgroundBrush}" BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="16" PreviewMouseWheel="Effect_MouseWheel">
                  <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.58" Color="#000000" /></Border.Effect>
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="EffectLabel" Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Intensity}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Slider x:Name="EffectSlider" Grid.Column="1" Style="{StaticResource ThicknessSliderStyle}"
                            Width="142" Minimum="2" Maximum="48" Value="8" TickFrequency="1"
                            IsSnapToTickEnabled="True" ValueChanged="Effect_Changed"
                            PreviewMouseWheel="Effect_MouseWheel" />
                    <TextBlock x:Name="EffectPopupValue" Grid.Column="2" Text="8" Foreground="{DynamicResource TextBrush}"
                               FontSize="13" TextAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:DragSliderOrUseMouseWheelTo}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,7,0,0" />
                  </Grid>
                </Border>
              </Popup>
            </Grid>
          </WrapPanel>

          <WrapPanel x:Name="GuidanceOptions" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock x:Name="GuidanceText" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
          </WrapPanel>
      </WrapPanel>
    </Border>
    <Border x:Name="SummaryResultPanel" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
            Background="{DynamicResource ToolbarBackgroundBrush}" BorderBrush="{DynamicResource ToolbarBorderBrush}"
            BorderThickness="1" CornerRadius="10" Padding="14" Width="380">
      <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" Color="{DynamicResource ToolbarShadowColor}" /></Border.Effect>
      <StackPanel>
        <DockPanel Margin="0,0,0,10">
          <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Click="CloseSummary_Click"
                  ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:CaptureSummaryClose}" AutomationProperties.Name="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:CaptureSummaryClose}">
            <iconPacks:PackIconLucide Kind="X" Width="16" Height="16" />
          </Button>
          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:CaptureSummary}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock x:Name="SummaryProgressText" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <ProgressBar x:Name="SummaryProgressBar" IsIndeterminate="True" Height="3" Margin="0,0,0,10" />
        <TextBox x:Name="SummaryResultText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MinHeight="60" MaxHeight="270"
                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" Padding="0" FontSize="14" />
        <WrapPanel Margin="0,10,0,0">
          <Button x:Name="CopySummaryButton" Style="{StaticResource ToolbarButton}" Width="Auto" Padding="10,5" Click="CopySummary_Click"
                  Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:CaptureSummaryCopy}" />
          <Button x:Name="RetrySummaryButton" Style="{StaticResource ToolbarButton}" Width="Auto" Padding="10,5" Click="Summary_Click"
                  Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:CaptureSummaryRetry}" />
          <Button x:Name="ConfigureSummaryButton" Style="{StaticResource ToolbarButton}" Width="Auto" Padding="10,5" Click="ConfigureSummary_Click" Visibility="Collapsed"
                  Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:CaptureSummaryConfigure}" />
        </WrapPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
