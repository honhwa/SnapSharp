            <Button Style="{StaticResource SecondaryButton}" Click="Color_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:CustomColor}"><iconPacks:PackIconLucide Kind="Palette" /></Button>
          </WrapPanel>

          <WrapPanel x:Name="FontOptions" Orientation="Horizontal" VerticalAlignment="Center">
            <Separator Style="{StaticResource SecondarySeparator}" />
            <Grid x:Name="FontFamilyControl" Margin="0,0,6,0">
              <ToggleButton Style="{StaticResource ToolbarFieldToggle}" x:Name="FontFamilyDropDownToggle" Width="154" Height="32" Background="{DynamicResource ControlBrush}"
