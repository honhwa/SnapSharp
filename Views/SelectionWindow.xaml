<Window x:Class="NimCap.Screenshot.Views.SelectionWindow" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="http://wpflocalizeextension.codeplex.com"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NimCap.Screenshot.Views"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" AllowsTransparency="True" Background="Black"
        Cursor="{x:Static local:PrecisionCursor.Cross}" KeyDown="Window_KeyDown" PreviewKeyUp="Window_KeyUp"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        PreviewMouseRightButtonDown="Window_PreviewMouseRightButtonDown">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ToolbarStyles.xaml" /></ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid x:Name="Root" ClipToBounds="True"
        MouseLeftButtonDown="Root_MouseLeftButtonDown"
        MouseMove="Root_MouseMove"
        MouseLeftButtonUp="Root_MouseLeftButtonUp">
    <Grid.Resources>
      <Style x:Key="SelectionHandleStyle" TargetType="primitives:Thumb">
        <Setter Property="Width" Value="12" /><Setter Property="Height" Value="12" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="#398BFF" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="primitives:Thumb">
          <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}"
                   StrokeThickness="{TemplateBinding BorderThickness}" />
        </ControlTemplate></Setter.Value></Setter>
      </Style>
    </Grid.Resources>
    <Image x:Name="Screenshot" Stretch="Fill" SnapsToDevicePixels="True" />
    <Path x:Name="Shade" Fill="#8A000000" IsHitTestVisible="False" />
    <Path x:Name="ShapeOutline" Stroke="#398BFF" StrokeThickness="2" Fill="Transparent"
          StrokeLineJoin="Round" Visibility="Collapsed" IsHitTestVisible="False" />
    <Image x:Name="EditedImageView" Visibility="Collapsed" Stretch="Fill" SnapsToDevicePixels="True"
           HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
    <local:AnnotationSurface x:Name="AnnotationView" Visibility="Collapsed"
                             HorizontalAlignment="Left" VerticalAlignment="Top" />
    <Border x:Name="SelectionBorder" BorderBrush="#398BFF" BorderThickness="2"
            Visibility="Collapsed" IsHitTestVisible="False" />
    <local:PixelGuides x:Name="PrecisionGuides" IsHitTestVisible="False" />
    <local:OcrTextLayer x:Name="TextSelectionLayer" Visibility="Collapsed"
                        HorizontalAlignment="Left" VerticalAlignment="Top" />

    <Border x:Name="InfoPanel" HorizontalAlignment="Left" VerticalAlignment="Top"
            Background="{DynamicResource OverlaySurfaceBrush}" CornerRadius="14" Padding="10,4" IsHitTestVisible="False">
      <StackPanel>
        <TextBlock x:Name="InfoText" Foreground="{DynamicResource OverlayTextBrush}" FontFamily="Consolas" FontSize="12" />
        <TextBlock x:Name="MovementHintText" Foreground="{DynamicResource OverlayTextBrush}" FontSize="11" Visibility="Collapsed" />
        <TextBlock x:Name="QrStatusText" Foreground="{DynamicResource OverlayTextBrush}" Visibility="Collapsed"
                   MaxWidth="300" TextWrapping="Wrap" Margin="0,3,0,0" />
      </StackPanel>
    </Border>

    <Border x:Name="Magnifier" Width="286" Height="300" HorizontalAlignment="Left" VerticalAlignment="Top"
            Background="{DynamicResource OverlaySurfaceBrush}" BorderBrush="#99000000" BorderThickness="1" CornerRadius="7"
            IsHitTestVisible="False" SnapsToDevicePixels="True">
      <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.38" Color="#000000" /></Border.Effect>
      <Grid Margin="9">
        <Grid.RowDefinitions><RowDefinition Height="154" /><RowDefinition /></Grid.RowDefinitions>
        <Grid ClipToBounds="True" Width="266" Height="154" Background="Black">
          <Image x:Name="ZoomImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True" />
          <Canvas x:Name="MagnifierPixelGrid" IsHitTestVisible="False" />
          <local:MagnifierReticle Columns="19" Rows="11" IsHitTestVisible="False" />
        </Grid>
        <Border Grid.Row="1" Background="#E6000000" CornerRadius="0,0,4,4" Padding="4,5">
          <StackPanel>
            <TextBlock x:Name="ColorCoordinates" Foreground="White" FontFamily="Consolas" FontSize="14" HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3">
            <Border x:Name="MagnifierColorSwatch" Width="16" Height="16" CornerRadius="3"
                    BorderBrush="#CCFFFFFF" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock x:Name="ColorText" Foreground="White" FontFamily="Consolas" FontSize="13"
                       VerticalAlignment="Center" TextWrapping="NoWrap" />
            </StackPanel>
            <TextBlock x:Name="ColorFormatText" Foreground="#FFC7CDD6" FontSize="10.5" HorizontalAlignment="Center" Margin="0,0,0,4" />
            <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:ShiftChangeColorFormat}" Foreground="White" FontSize="13" HorizontalAlignment="Center" />
            <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:CCopyColorAndExitCapture}" Foreground="White" FontSize="13" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <TextBlock x:Name="Hint" Foreground="{DynamicResource OverlayTextBrush}"
               Background="{DynamicResource OverlaySurfaceBrush}" Padding="12,7" HorizontalAlignment="Center"
               VerticalAlignment="Top" Margin="0,30,0,0" IsHitTestVisible="False">
      <Run x:Name="CaptureHintText" Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:DragToSelectClickToSelectWindow}" /><Run Text=" | " /><Run x:Name="GuideShortcutHint" />
    </TextBlock>

    <!-- Keep the visibility marker non-interactive. The resize thumbs are direct
         siblings so an empty full-screen panel cannot intercept annotation input. -->
    <Border x:Name="Handles" Width="0" Height="0" Visibility="Collapsed" IsHitTestVisible="False" />
    <primitives:Thumb x:Name="TopLeftHandle" Style="{StaticResource SelectionHandleStyle}"
                      Visibility="{Binding Visibility, ElementName=Handles}" Tag="TopLeft" Cursor="SizeNWSE" DragDelta="Handle_DragDelta" DragCompleted="Handle_DragCompleted" />
    <primitives:Thumb x:Name="TopCenterHandle" Style="{StaticResource SelectionHandleStyle}"
                      Visibility="{Binding Visibility, ElementName=Handles}" Tag="Top" Cursor="SizeNS" DragDelta="Handle_DragDelta" DragCompleted="Handle_DragCompleted" />
    <primitives:Thumb x:Name="TopRightHandle" Style="{StaticResource SelectionHandleStyle}"
                      Visibility="{Binding Visibility, ElementName=Handles}" Tag="TopRight" Cursor="SizeNESW" DragDelta="Handle_DragDelta" DragCompleted="Handle_DragCompleted" />
    <primitives:Thumb x:Name="MiddleLeftHandle" Style="{StaticResource SelectionHandleStyle}"
                      Visibility="{Binding Visibility, ElementName=Handles}" Tag="Left" Cursor="SizeWE" DragDelta="Handle_DragDelta" DragCompleted="Handle_DragCompleted" />
    <primitives:Thumb x:Name="MiddleRightHandle" Style="{StaticResource SelectionHandleStyle}"
                      Visibility="{Binding Visibility, ElementName=Handles}" Tag="Right" Cursor="SizeWE" DragDelta="Handle_DragDelta" DragCompleted="Handle_DragCompleted" />
    <primitives:Thumb x:Name="BottomLeftHandle" Style="{StaticResource SelectionHandleStyle}"
                      Visibility="{Binding Visibility, ElementName=Handles}" Tag="BottomLeft" Cursor="SizeNESW" DragDelta="Handle_DragDelta" DragCompleted="Handle_DragCompleted" />
    <primitives:Thumb x:Name="BottomCenterHandle" Style="{StaticResource SelectionHandleStyle}"
                      Visibility="{Binding Visibility, ElementName=Handles}" Tag="Bottom" Cursor="SizeNS" DragDelta="Handle_DragDelta" DragCompleted="Handle_DragCompleted" />
    <primitives:Thumb x:Name="BottomRightHandle" Style="{StaticResource SelectionHandleStyle}"
                      Visibility="{Binding Visibility, ElementName=Handles}" Tag="BottomRight" Cursor="SizeNWSE" DragDelta="Handle_DragDelta" DragCompleted="Handle_DragCompleted" />

    <Border x:Name="CapturePanel" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,66,0,0"
            Background="{DynamicResource OverlaySurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="6" Padding="5">
      <StackPanel Orientation="Horizontal">
        <ComboBox x:Name="CaptureModePicker" Width="82" SelectionChanged="CaptureMode_Changed" DropDownOpened="CapturePicker_Opened" DropDownClosed="CapturePicker_Closed" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:CaptureMode}">
          <ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Region}" Tag="Region" IsSelected="True" />
          <ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Element}" Tag="Element" />
          <ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Window}" Tag="Window" />
          <ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:FullScreen}" Tag="FullScreen" />
        </ComboBox>
        <ComboBox x:Name="ShapePicker" Width="92" Margin="5,0,0,0" SelectionChanged="Shape_Changed" DropDownOpened="CapturePicker_Opened" DropDownClosed="CapturePicker_Closed" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:SelectionShape}">
          <ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Rectangle}" Tag="Rectangle" IsSelected="True" />
          <ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Ellipse}" Tag="Ellipse" />
          <ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:FreehandLasso}" Tag="Lasso" />
          <ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Polygon}" Tag="Polygon" />
        </ComboBox>
        <ComboBox x:Name="RatioPicker" Width="76" Margin="5,0,0,0" SelectionChanged="Ratio_Changed" DropDownOpened="CapturePicker_Opened" DropDownClosed="CapturePicker_Closed" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:AspectRatio}">
          <ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Free}" Tag="Free" IsSelected="True" />
          <ComboBoxItem Content="1:1" Tag="1" />
          <ComboBoxItem Content="4:3" Tag="1.333333333333" />
          <ComboBoxItem Content="16:9" Tag="1.777777777778" />
        </ComboBox>
        <ToggleButton x:Name="CaptureRulerButton" Style="{StaticResource ToolbarFieldToggle}" Margin="3,0" Width="32" HorizontalContentAlignment="Center" Click="Ruler_Click">
          <iconPacks:PackIconLucide Kind="Ruler" Width="18" Height="18" />
        </ToggleButton>
        <ToggleButton x:Name="CaptureCrosshairButton" Style="{StaticResource ToolbarFieldToggle}" Margin="3,0" Width="32" HorizontalContentAlignment="Center" Click="Crosshair_Click">
          <iconPacks:PackIconLucide Kind="Plus" Width="18" Height="18" />
        </ToggleButton>
      </StackPanel>
    </Border>

    <Border x:Name="RecognitionActionsPanel" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
            Background="{DynamicResource OverlaySurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="8" Padding="5">
      <StackPanel>
      <StackPanel x:Name="CaptureRecognitionCommands" Orientation="Horizontal">
        <Button x:Name="RecognizeTextButton" Style="{StaticResource ToolbarButton}" Width="Auto" Padding="10,5" Click="Recognition_Click">
          <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconLucide Kind="ScanText" Margin="0,0,7,0" />
            <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:CaptureRecognizeText}" VerticalAlignment="Center" />
            <TextBlock Text="O" Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="SummarizeCaptureButton" Style="{StaticResource ToolbarButton}" Width="Auto" Padding="10,5" Click="Summary_Click">
          <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconLucide Kind="List" Margin="0,0,7,0" />
            <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:CaptureSummary}" VerticalAlignment="Center" />
            <TextBlock Text="J" Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="RedactCaptureButton" Style="{StaticResource ToolbarButton}" Width="Auto" Padding="10,5" Click="Redact_Click" ToolTipService.ShowOnDisabled="True" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:OneClickRedact}">
          <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconLucide Kind="Shield" Margin="0,0,7,0" />
            <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:OneClickRedact}" VerticalAlignment="Center" />
            <TextBlock Text="D" Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
      <StackPanel x:Name="TextSelectionCommands" Orientation="Horizontal" Visibility="Collapsed">
        <Button x:Name="CopyAllRecognizedTextButton" Style="{StaticResource ToolbarButton}" Width="Auto" Padding="10,5"
                Click="CopyAllRecognizedText_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:CaptureTextCopyAll}" VerticalAlignment="Center" />
            <TextBlock Text="O" Margin="12,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource ToolbarButton}" Width="Auto" Padding="10,5" Click="Summary_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:CaptureSummary}" VerticalAlignment="Center" />
            <TextBlock Text="J" Margin="12,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource ToolbarButton}" Width="Auto" Padding="10,5" Click="ExitTextRecognition_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:CaptureTextBackToEditing}" VerticalAlignment="Center" />
            <TextBlock Text="Esc" Margin="12,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
      <TextBlock x:Name="TextRecognitionStatus" Visibility="Collapsed" MaxWidth="460" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,3" FontSize="12" />
      </StackPanel>
    </Border>

    <Border x:Name="ToolPanel" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
            Background="{DynamicResource ToolbarBackgroundBrush}" BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="1" CornerRadius="10"
            Padding="8,6" MaxWidth="1040" TextElement.FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
      <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.42" Color="{DynamicResource ToolbarShadowColor}" /></Border.Effect>
      <Border.Resources>
        <Style x:Key="CaptureToolButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}" />
        <Style x:Key="PrimaryArrowOptionButton" TargetType="Button" BasedOn="{StaticResource CaptureToolButton}">
          <Setter Property="Width" Value="104" /><Setter Property="Height" Value="32" />
          <Setter Property="MinWidth" Value="104" /><Setter Property="Margin" Value="0,1" />
          <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style TargetType="Separator" BasedOn="{StaticResource ToolbarSeparator}" />
        <Style TargetType="iconPacks:PackIconLucide" BasedOn="{StaticResource ToolbarIcon}" />
      </Border.Resources>
      <WrapPanel x:Name="ToolButtons" Orientation="Horizontal" VerticalAlignment="Top">
        <Button x:Name="MoveSelectionButton" Style="{StaticResource CaptureToolButton}" Click="MoveSelection_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:MoveSelection}"><iconPacks:PackIconLucide Kind="Move" /></Button>
        <ToggleButton x:Name="EditorRulerButton" Style="{StaticResource ToolbarFieldToggle}" Margin="3,0" Width="32" HorizontalContentAlignment="Center" Click="Ruler_Click">
          <iconPacks:PackIconLucide Kind="Ruler" Width="18" Height="18" />
        </ToggleButton>
        <ToggleButton x:Name="EditorCrosshairButton" Style="{StaticResource ToolbarFieldToggle}" Margin="3,0" Width="32" HorizontalContentAlignment="Center" Click="Crosshair_Click">
          <iconPacks:PackIconLucide Kind="Plus" Width="18" Height="18" />
        </ToggleButton>
        <Separator />
        <local:ToolGroupButton x:Name="ShapeTools" Group="Shapes" ToolSelected="ToolGroup_ToolSelected" />
        <Button Style="{StaticResource CaptureToolButton}" Tag="Line" Click="Tool_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Line}"><iconPacks:PackIconLucide Kind="Minus" /></Button>
        <Button Style="{StaticResource CaptureToolButton}" Tag="Arrow" Click="Tool_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Arrow}"><iconPacks:PackIconLucide Kind="ArrowUpRight" /></Button>
        <Grid Width="14" Height="32" Margin="-5,0,2,0">
          <ToggleButton x:Name="PrimaryArrowStyleDropDownToggle" Width="14" Height="32" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:ChooseArrowStyle}">
            <ToggleButton.Template>
              <ControlTemplate TargetType="ToggleButton">
                <Border x:Name="PrimaryArrowDropSurface" Background="{TemplateBinding Background}" CornerRadius="4">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PrimaryArrowDropSurface" Property="Background" Value="{DynamicResource ControlHoverBrush}" /></Trigger>
                  <Trigger Property="IsChecked" Value="True"><Setter TargetName="PrimaryArrowDropSurface" Property="Background" Value="{DynamicResource ToolbarActiveBrush}" /></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </ToggleButton.Template>
            <iconPacks:PackIconLucide Kind="ChevronDown" Width="12" Height="12" Foreground="{DynamicResource TextSecondaryBrush}" />
          </ToggleButton>
          <Popup PlacementTarget="{Binding ElementName=PrimaryArrowStyleDropDownToggle}" Placement="Bottom"
                 HorizontalOffset="-43" VerticalOffset="5" AllowsTransparency="True" PopupAnimation="Fade"
                 StaysOpen="False" IsOpen="{Binding IsChecked, ElementName=PrimaryArrowStyleDropDownToggle, Mode=TwoWay}">
            <Border Width="116" Background="{DynamicResource ToolbarBackgroundBrush}" BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="4">
              <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.58" Color="#000000" /></Border.Effect>
              <StackPanel x:Name="PrimaryArrowStyleMenu">
                <Button Style="{StaticResource PrimaryArrowOptionButton}" Tag="TaperedOutline" Click="PrimaryArrowStyleButton_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:TaperedOutlineArrow}"><local:ArrowStylePreview ArrowStyle="TaperedOutline" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
                <Button Style="{StaticResource PrimaryArrowOptionButton}" Tag="TaperedFilled" Click="PrimaryArrowStyleButton_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:TaperedFilledArrow}"><local:ArrowStylePreview ArrowStyle="TaperedFilled" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
                <Button Style="{StaticResource PrimaryArrowOptionButton}" Tag="EndOpen" Click="PrimaryArrowStyleButton_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:SingleArrow}"><local:ArrowStylePreview ArrowStyle="EndOpen" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
                <Button Style="{StaticResource PrimaryArrowOptionButton}" Tag="BothOpen" Click="PrimaryArrowStyleButton_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:DoubleArrow}"><local:ArrowStylePreview ArrowStyle="BothOpen" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
                <Button Style="{StaticResource PrimaryArrowOptionButton}" Tag="StartOpen" Click="PrimaryArrowStyleButton_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:ReverseArrow}"><local:ArrowStylePreview ArrowStyle="StartOpen" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
                <Button Style="{StaticResource PrimaryArrowOptionButton}" Tag="EndFilled" Click="PrimaryArrowStyleButton_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:FilledArrow}"><local:ArrowStylePreview ArrowStyle="EndFilled" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
                <Button Style="{StaticResource PrimaryArrowOptionButton}" Tag="BothFilled" Click="PrimaryArrowStyleButton_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:DoubleFilledArrow}"><local:ArrowStylePreview ArrowStyle="BothFilled" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
                <Button Style="{StaticResource PrimaryArrowOptionButton}" Tag="EndOpenStartBar" Click="PrimaryArrowStyleButton_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:ArrowWithStartBar}"><local:ArrowStylePreview ArrowStyle="EndOpenStartBar" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
                <Button Style="{StaticResource PrimaryArrowOptionButton}" Tag="StartOpenEndBar" Click="PrimaryArrowStyleButton_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:ArrowWithEndBar}"><local:ArrowStylePreview ArrowStyle="StartOpenEndBar" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
                <Button Style="{StaticResource PrimaryArrowOptionButton}" Tag="Bars" Click="PrimaryArrowStyleButton_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:BarsAtBothEnds}"><local:ArrowStylePreview ArrowStyle="Bars" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
              </StackPanel>
            </Border>
          </Popup>
        </Grid>
        <Separator />
        <local:ToolGroupButton x:Name="InkTools" Group="Ink" ToolSelected="ToolGroup_ToolSelected" />
        <Separator />
        <local:ToolGroupButton x:Name="TextTools" Group="Text" ToolSelected="ToolGroup_ToolSelected" />
        <Button Style="{StaticResource CaptureToolButton}" Tag="Number" Click="Tool_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:NumberAnnotation}">
          <Viewbox Width="18" Height="18">
            <Canvas Width="24" Height="24">
              <Ellipse Canvas.Left="3" Canvas.Top="3" Width="18" Height="18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" />
              <Path Data="M 10,9 L 12,7.5 L 12,16 M 10,16 L 14,16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Canvas>
          </Viewbox>
        </Button>
        <Separator />
        <local:ToolGroupButton x:Name="EffectTools" Group="Effects" ToolSelected="ToolGroup_ToolSelected" />
        <Separator />
        <Button Style="{StaticResource CaptureToolButton}" Tag="Select" Click="Tool_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:SelectObject}"><iconPacks:PackIconLucide Kind="MousePointer2" /></Button>
        <Button Style="{StaticResource CaptureToolButton}" Tag="Eraser" Click="Tool_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:DeleteAnnotation}"><iconPacks:PackIconLucide Kind="Eraser" /></Button>
        <Separator />
        <Button Style="{StaticResource CaptureToolButton}" Click="Color_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:AnnotationColor}"><iconPacks:PackIconLucide Kind="Palette" /></Button>
        <Button Style="{StaticResource CaptureToolButton}" Command="{Binding UndoCommand}" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:UndoCtrlZ}"><iconPacks:PackIconLucide Kind="Undo2" /></Button>
        <Button Style="{StaticResource CaptureToolButton}" Command="{Binding RedoCommand}" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RedoCtrlY2}"><iconPacks:PackIconLucide Kind="Redo2" /></Button>
        <Menu Visibility="Collapsed" Height="32" FontSize="13" Background="Transparent" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center">
          <Menu.Resources>
            <Style TargetType="Separator" BasedOn="{StaticResource AppMenuSeparator}" />
            <Style TargetType="MenuItem" BasedOn="{StaticResource AppMenuItem}" />
          </Menu.Resources>
          <MenuItem Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Objects}">
            <MenuItem Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:CopyObjectCtrlC}" Click="ObjectCopy_Click" />
            <MenuItem Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:PasteObjectCtrlV}" Click="ObjectPaste_Click" />
            <MenuItem Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:DeleteObjectDelete}" Click="ObjectDelete_Click" />
            <Separator />
            <MenuItem Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:BringForward}" Click="LayerUp_Click" />
            <MenuItem Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:SendBackward}" Click="LayerDown_Click" />
            <MenuItem Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:BringToFront}" Click="LayerTop_Click" />
            <MenuItem Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:SendToBack}" Click="LayerBottom_Click" />
          </MenuItem>
          <MenuItem Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Image}">
            <MenuItem Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Rotate90Clockwise}" Click="RotateClockwise_Click" />
            <MenuItem Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Rotate90Counterclockwise}" Click="RotateCounterClockwise_Click" />
            <MenuItem Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:FlipHorizontallyKeepTextReadable}" Click="FlipHorizontal_Click" />
            <MenuItem Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:FlipVerticallyKeepTextReadable}" Click="FlipVertical_Click" />
            <MenuItem Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:ExpandCanvas2}" Click="ExpandCanvas_Click" />
          </MenuItem>
          <MenuItem Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Templates}">
            <MenuItem Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:ExportAnnotationTemplate}" Click="SaveTemplate_Click" />
            <MenuItem Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:ImportAnnotationTemplate}" Click="LoadTemplate_Click" />
          </MenuItem>
        </Menu>
        <Separator />
