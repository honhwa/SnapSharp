                  <iconPacks:PackIconLucide Grid.Column="1" Kind="ChevronDown" Width="15" Height="15"
                                              Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
              </ToggleButton>
              <Popup x:Name="FontFamilyPopup" PlacementTarget="{Binding ElementName=FontFamilyDropDownToggle}"
                     Placement="Bottom" VerticalOffset="6" AllowsTransparency="True" PopupAnimation="Fade"
