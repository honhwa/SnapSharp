                            PreviewMouseWheel="FillOpacity_MouseWheel">
                <Grid Margin="8,0,7,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid Width="16" Height="16" VerticalAlignment="Center">
                    <Rectangle Fill="#31343A" RadiusX="3" RadiusY="3" />
                    <Rectangle Width="8" HorizontalAlignment="Left" Fill="{DynamicResource TextBrush}" RadiusX="3" RadiusY="3" />
                    <Border BorderBrush="#8E949F" BorderThickness="1" CornerRadius="3" />
