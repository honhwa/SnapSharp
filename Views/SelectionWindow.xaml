                            Checked="FontFamilyDropDownToggle_Checked">
                <Grid Margin="10,0,7,0">
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="20" /></Grid.ColumnDefinitions>
                  <TextBlock x:Name="FontFamilyText" Text="Segoe UI" Foreground="{DynamicResource TextBrush}" FontSize="13"
