            <Button Style="{StaticResource ColorSwatchButton}" Tag="#FF9F0A" Click="PaletteColor_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Orange}" Background="#FF9F0A" />
            <Button Style="{StaticResource ColorSwatchButton}" Tag="#FFD60A" Click="PaletteColor_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Yellow}" Background="#FFD60A" />
            <Button Style="{StaticResource ColorSwatchButton}" Tag="#30D158" Click="PaletteColor_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Green}" Background="#30D158" />
            <Button Style="{StaticResource ColorSwatchButton}" Tag="#0A84FF" Click="PaletteColor_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Blue}" Background="#0A84FF" />
            <Button Style="{StaticResource ColorSwatchButton}" Tag="#BF5AF2" Click="PaletteColor_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Purple}" Background="#BF5AF2" />
            <Button Style="{StaticResource ColorSwatchButton}" Tag="#111111" Click="PaletteColor_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Black}" Background="#111111" BorderBrush="#77777C" />
