<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <IsNimCapApp>true</IsNimCapApp>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <AssemblyName>NimCap.Screenshot</AssemblyName>
    <Title>NimCap Screenshot</Title>
    <Product>NimCap Screenshot</Product>
    <Company>NimCap</Company>
    <RepositoryUrl>https://github.com/nimcap/nimcap-screenshot</RepositoryUrl>
    <PackageProjectUrl>https://jietu.nimcap.com</PackageProjectUrl>
    <Description>NimCap 截图工具</Description>
    <RootNamespace>NimCap.Screenshot</RootNamespace>
    <Version>1.1.6</Version>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <Microsoft_AI_DirectML_SkipDebugLayerCopy>true</Microsoft_AI_DirectML_SkipDebugLayerCopy>
  </PropertyGroup>
  <ItemGroup>
    <!-- Match the runtime versions covered by ThirdPartyLicenses without
         overriding the Windows SDK projection pack's independent version. -->
    <FrameworkReference Update="Microsoft.NETCore.App;Microsoft.WindowsDesktop.App;Microsoft.WindowsDesktop.App.WPF;Microsoft.WindowsDesktop.App.WindowsForms"
                        RuntimeFrameworkVersion="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="MahApps.Metro.IconPacks.Lucide" Version="6.2.1" />
    <!-- Shell windows also use the native capture-exclusion API. -->
    <PackageReference Include="ScreenRecorderLib" Version="7.0.1" />
    <PackageReference Include="GTranslate" Version="2.4.0" />
    <!-- Direct dependency imports the native copy target in the x64 app,
         rather than relying on the OS copy of DirectML.dll. -->
    <PackageReference Include="Microsoft.AI.DirectML" Version="1.15.4" />
    <PackageReference Include="WPFLocalizeExtension" Version="3.10.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Libraries\NimCap.Screenshot.Core\NimCap.Screenshot.Core.csproj" />
    <ProjectReference Include="Libraries\NimCap.Screenshot.Imaging\NimCap.Screenshot.Imaging.csproj" />
    <ProjectReference Include="Libraries\NimCap.Screenshot.Recognition\NimCap.Screenshot.Recognition.csproj" />
    <ProjectReference Include="Libraries\NimCap.Screenshot.Editor\NimCap.Screenshot.Editor.csproj" />
    <ProjectReference Include="Libraries\NimCap.Screenshot.Capture\NimCap.Screenshot.Capture.csproj" />
    <ProjectReference Include="Libraries\NimCap.Screenshot.Recording\NimCap.Screenshot.Recording.csproj" />
    <ProjectReference Include="Libraries\NimCap.Screenshot.Infrastructure\NimCap.Screenshot.Infrastructure.csproj" />
    <ProjectReference Include="Libraries\NimCap.Screenshot.Plugin.Abstractions\NimCap.Screenshot.Plugin.Abstractions.csproj" />
    <ProjectReference Include="Libraries\NimCap.Screenshot.PluginHost\NimCap.Screenshot.PluginHost.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Cli\**\*.cs" />
    <Compile Remove="tools\CliChecks\**\*.cs" />
    <Compile Remove="Libraries\**\*.cs" />
    <Compile Remove="tools\RegressionChecks\**\*.cs" />
    <Compile Remove="tools\ScrollingChecks\**\*.cs" />
    <Compile Remove="tools\RecordingChecks\**\*.cs" />
    <Compile Remove="tools\UpdateChecks\**\*.cs" />
    <Compile Remove="tools\WindowChecks\**\*.cs" />
    <Compile Remove="tools\ModelStorageChecks\**\*.cs" />
    <Compile Remove="tools\StabilityChecks\**\*.cs" />
    <Page Remove="Libraries\**\*.xaml" />
    <EmbeddedResource Remove="Libraries\**\*" />
    <Resource Include="logo.ico" />
  </ItemGroup>
  <ItemGroup>
    <None Update="LICENSE;THIRD-PARTY-NOTICES.md;README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="ThirdPartyLicenses\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Services\AppUpdate.ps1" LogicalName="NimCap.Screenshot.AppUpdate.ps1" />
    <EmbeddedResource Include="Resources\Models\slbr-install.json.gz" LogicalName="NimCap.Screenshot.SlbrInstallRecipe" />
    <InternalsVisibleTo Include="NimCap.Screenshot.RegressionChecks" />
    <InternalsVisibleTo Include="NimCap.Screenshot.RecordingChecks" />
    <InternalsVisibleTo Include="ScrollingChecks" />
    <InternalsVisibleTo Include="NimCap.Screenshot.WindowChecks" />
    <InternalsVisibleTo Include="NimCap.Screenshot.ModelStorageChecks" />
    <InternalsVisibleTo Include="NimCap.Screenshot.StabilityChecks" />
  </ItemGroup>
</Project>
